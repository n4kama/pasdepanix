<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>org.pasdepanix.calendar-mcp</string>
  <key>CFBundleName</key>
  <string>calendar-mcp</string>
  <key>CFBundleExecutable</key>
  <string>calendar-mcp</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <!-- No Dock icon or menu bar while a query runs. -->
  <key>LSUIElement</key>
  <true/>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>calendar-mcp lists your events to Claude, adds the ones Claude creates and moves the ones Claude reschedules. It never deletes any.</string>
  <key>NSRemindersFullAccessUsageDescription</key>
  <string>calendar-mcp lists your reminders to Claude and adds the ones Claude creates. It never changes or deletes existing ones.</string>
</dict>
</plist>
